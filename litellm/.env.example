# Copy to .env and fill in. Never commit .env.
TZ=Europe/Skopje

# Admin password for /ui and the bearer token clients send. Must start with "sk-".
# Generate: printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=
# Encrypts provider credentials in Postgres. Do not rotate casually. Generate: openssl rand -hex 32
LITELLM_SALT_KEY=

# Postgres (db service)
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm

# OpenCode Go key: Console -> Account -> Personal API keys
OPENCODE_API_KEY=

# Optional LAN box running swift-1.5 (free local model, used as classifier)
STRATA_API_BASE=http://192.168.1.134:8080/v1
STRATA_API_KEY=

# Claude Pro subscription, served through CLIProxyAPI (see litellm/README.md).
# Direct Anthropic OAuth from LiteLLM is 429-gated, so LiteLLM talks to the
# cliproxyapi service instead. Generate any local key: openssl rand -hex 24
CLIPROXY_API_KEY=
CLIPROXY_API_BASE=http://cliproxyapi:8317/v1

# go_router.py's ProviderBalanceFilter polls Claude Pro's own quota endpoint
# by reading the OAuth access_token straight off the credential file
# cliproxyapi/auth maintains (mounted read-only into the litellm container at
# CLAUDE_OAUTH_AUTH_DIR, default /app/cliproxy-auth). No extra key needed here.

# 1 = show the "> ⚡ routed via <model>" marker at the top and bottom of the
# answer (the TUI toasts still fire); 0 = keep the answer text clean.
LITELLM_SHOW_ROUTE_MARKER=1
