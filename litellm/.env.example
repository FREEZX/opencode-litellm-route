# Copy to .env and fill in. Never commit .env.
TZ=Europe/Skopje

# Admin password for /ui and the bearer token clients send. Must start with "sk-".
# Generate: printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=
# Encrypts provider credentials in Postgres. Do not rotate casually. Generate: openssl rand -hex 32
LITELLM_SALT_KEY=

# Postgres (db service)
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm

# OpenCode Go key: Console -> Account -> Personal API keys
OPENCODE_API_KEY=

# Optional LAN box running swift-1.5 (free local model, used as classifier)
STRATA_API_BASE=http://192.168.1.134:8080/v1
STRATA_API_KEY=

# 0 = keep the answer text clean; the TUI plugin shows the route as a toast
LITELLM_SHOW_ROUTE_MARKER=0
